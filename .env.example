# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=gpt-4o-mini-transcribe

# Listener config
WHISPER_MODEL_SIZE=tiny
WHISPER_DEVICE=cpu
SAMPLE_RATE=16000
MIC_MODE=voice
MIC_CHUNK_SECONDS=3.0
ENERGY_THRESHOLD=0.003
CONFIDENCE_THRESHOLD=-1.1

# App behavior
TRANSCRIPT_BUFFER_SIZE=120
SUMMARY_UPDATE_SECONDS=8
DEMO_TICK_SECONDS=1.5
DEMO_SOURCE_PATH=data/demo_transcript.jsonl
LOG_DIR=logs
